---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
const posts = await getCollection("posts", ({ data }) => !data.draft);
const ym = new Intl.DateTimeFormat("ko-KR", { year: "numeric", month: "long", timeZone: "UTC" });

// 홈: 머리 문구 → 최근 글 4편 → 주제 묶음. 묶음 안은 논문 연도 → order → 작성일 순서다.
// 참고: deepmind.google/research (큰 두 톤 제목, 두 칸 목록, 가는 구분선)
const groups = [
  { key: "basics", label: "학습의 기초", sub: "역전파에서 정규화까지, 신경망이 배우는 방법" },
  { key: "vision", label: "이미지", sub: "깊은 합성곱 신경망의 두 이정표" },
  { key: "language", label: "언어와 시퀀스", sub: "단어 벡터에서 번역, 어텐션까지" },
  { key: "generative", label: "생성 모델", sub: "데이터를 새로 만들어 내는 두 가지 방법" },
  { key: "context", label: "큰 그림과 최신 연구", sub: "튜링의 질문에서 오늘의 LLM까지" },
  { key: undefined, label: "그 밖의 글", sub: "" },
];
const groupLabel = Object.fromEntries(groups.map((g) => [g.key ?? "etc", g.label]));
const kindLabel = { lab: "실습", qa: "논문 Q&A", concept: "개념", research: "연구 소개" } as const;
const titleOf = (p: (typeof posts)[number]) =>
  p.data.shortTitle ? (p.data.tagline ? `${p.data.shortTitle}: ${p.data.tagline}` : p.data.shortTitle) : p.data.title;

const latest = [...posts].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 4);
const sections = groups
  .map((g) => ({
    ...g,
    posts: posts
      .filter((p) => p.data.category === g.key)
      .sort(
        (a, b) =>
          (a.data.paperYear ?? 9999) - (b.data.paperYear ?? 9999) ||
          a.data.order - b.data.order ||
          a.data.date.valueOf() - b.data.date.valueOf(),
      ),
  }))
  .filter((g) => g.posts.length > 0);
---

<BaseLayout title="explainers" description="공부하며 질문한 내용을 그림과 예시로 풀어 쓴 설명글 모음">
  <main>
    <section class="hero">
      <h1>explainers</h1>
    </section>

    <section class="block" id="latest">
      <div class="block-head">
        <h2>최근 글</h2>
        <a class="pill" href="#basics">주제별로 보기</a>
      </div>
      <ul class="grid">
        {latest.map((p) => (
          <li>
            <a class="item item-lg" href={`${base}posts/${p.id}/`}>
              <span class="item-title">{titleOf(p)}</span>
              <span class="item-meta">
                <span>{ym.format(p.data.date)}</span>
                <span>{groupLabel[p.data.category ?? "etc"]}</span>
                <span class="more">읽기<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5" /></svg></span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    {sections.map((s) => (
      <section class="block" id={s.key ?? "etc"}>
        <div class="block-head">
          <h2>
            {s.label}
            {s.sub && <span class="sub">{s.sub}</span>}
          </h2>
        </div>
        <ul class="grid">
          {s.posts.map((p) => {
            const d = p.data;
            return (
              <li>
                <a class="item" href={`${base}posts/${p.id}/`}>
                  <span class="item-title">{titleOf(p)}</span>
                  <span class="item-meta">
                    {d.paperYear && <span>{d.paperYear}</span>}
                    {d.authors && <span>{d.authors}</span>}
                    {d.kind !== "lab" && <span>{kindLabel[d.kind]}</span>}
                    <span class="more">읽기<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5" /></svg></span>
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    ))}

    <footer class="foot">
      <p class="foot-line">공부하며 질문한 내용을<br />그림과 예시로 풀어 씁니다</p>
      <div class="foot-col">
        <p class="foot-head">주제</p>
        {sections.map((s) => <a href={`#${s.key ?? "etc"}`}>{s.label}</a>)}
      </div>
      <div class="foot-col">
        <p class="foot-head">둘러보기</p>
        <a href="#latest">최근 글</a>
        <a href="#">맨 위로</a>
      </div>
    </footer>
  </main>
</BaseLayout>

<style>
  main {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 72px;
    color: var(--text-primary);
    word-break: keep-all;
  }

  .hero { padding: 88px 0 120px; text-align: center; }
  .eyebrow { margin: 0 0 20px; font-size: 17px; line-height: 24px; color: var(--text-secondary); }
  .hero h1 {
    margin: 0 auto;
    max-width: 900px;
    font-size: 54px;
    line-height: 1.12;
    font-weight: 600;
    letter-spacing: -0.035em;
  }

  .block {
    margin: 0 -72px;
    padding: 72px 72px 96px;
    border-top: 1px solid var(--border-weak);
    scroll-margin-top: 8px;
  }
  .block-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; margin-bottom: 32px; }
  .block-head h2 {
    margin: 0;
    font-size: 32px;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .block-head .sub { display: block; margin-top: 8px; font-size: 20px; line-height: 1.4; letter-spacing: -0.01em; color: var(--text-tertiary); font-weight: 500; }
  .pill {
    flex: none;
    padding: 6px 16px;
    border: 1px solid var(--border-default);
    border-radius: 999px;
    font-size: 15px;
    line-height: 22px;
    font-weight: 500;
    color: var(--text-primary);
    text-decoration: none;
    transition: background-color 120ms;
  }
  .pill:hover { background: var(--fill-hover); }

  .grid {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 48px;
  }
  .grid li { border-bottom: 1px solid var(--border-weak); }

  .item {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0 -16px;
    padding: 30px 16px 32px;
    border-radius: 16px;
    color: inherit;
    text-decoration: none;
    transition: background-color 120ms;
  }
  .item:hover { background: var(--bg-subtle); }
  .item:focus-visible { outline: 2px solid var(--border-focus); outline-offset: 2px; }
  .item-title {
    font-size: 24px;
    line-height: 1.3;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .item-lg .item-title { font-size: 28px; line-height: 1.25; }
  .item-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 16px;
    row-gap: 4px;
    font-size: 14px;
    line-height: 22px;
    color: var(--text-secondary);
  }
  .more { display: inline-flex; align-items: center; gap: 6px; font-size: 15px; color: var(--text-primary); font-weight: 500; }
  .more svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.5; transition: transform 120ms; }
  .item:hover .more svg { transform: translateX(3px); }

  .foot {
    margin: 0 -72px;
    padding: 80px 72px 120px;
    border-top: 1px solid var(--border-weak);
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 48px;
  }
  .foot-line { margin: 0; font-size: 32px; line-height: 1.2; font-weight: 600; letter-spacing: -0.03em; }
  .foot-col { display: flex; flex-direction: column; gap: 10px; font-size: 16px; line-height: 24px; }
  .foot-head { margin: 0 0 6px; font-size: 20px; line-height: 28px; font-weight: 600; }
  .foot-col a { color: var(--text-primary); text-decoration: none; }
  .foot-col a:hover { color: var(--text-secondary); }

  @media (max-width: 900px) {
    main { padding: 0 20px; }
    .hero { padding: 56px 0 72px; }
    .hero h1 { font-size: 36px; }
    .block { margin: 0 -20px; padding: 48px 20px 64px; }
    .block-head h2 { font-size: 26px; }
    .block-head .sub { font-size: 17px; }
    .grid { grid-template-columns: 1fr; }
    .item-title, .item-lg .item-title { font-size: 21px; }
    .item { padding: 22px 16px 24px; }
    .foot { margin: 0 -20px; padding: 56px 20px 80px; grid-template-columns: 1fr 1fr; }
    .foot-line { grid-column: 1 / -1; font-size: 26px; }
  }
</style>
