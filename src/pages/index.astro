---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = new Intl.DateTimeFormat("ko-KR", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
---

<BaseLayout title="explainers" description="공부하며 질문한 내용을 그림과 예시로 풀어 쓴 설명글 모음">
  <main class="mx-auto max-w-[700px] px-5 pb-24 pt-12">
    <h1 class="m-0 text-[30px] font-bold leading-9">explainers</h1>
    <p class="mb-0 mt-3 text-[16px] leading-6 text-ink-2">
      공부하며 질문한 내용을 그림과 예시로 풀어 쓴 설명글 모음입니다.
    </p>
    <ul class="m-0 mt-12 flex list-none flex-col gap-4 p-0">
      {
        posts.map((post) => (
          <li>
            <a
              href={`${base}posts/${post.id}/`}
              class="block rounded-2xl border border-line p-5 text-ink no-underline transition-colors duration-[120ms] hover:bg-[var(--fill-hover)]"
            >
              <h2 class="m-0 text-[20px] font-semibold leading-[26px]">{post.data.title}</h2>
              <p class="mb-0 mt-2 text-[14px] leading-5 text-ink-2">{post.data.summary}</p>
              <time class="mt-3 block text-[12px] leading-4 text-ink-3" datetime={post.data.date.toISOString()}>
                {fmt.format(post.data.date)}
              </time>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>
