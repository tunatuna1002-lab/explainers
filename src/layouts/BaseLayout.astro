---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  hideNav?: boolean;
}
const { title, description, hideNav = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const siteName = "explainers";
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
// 머리말 메뉴: 홈의 주제 묶음으로 바로 간다 (src/pages/index.astro의 groups와 같은 id)
const nav = [
  { href: `${base}#basics`, label: "학습의 기초" },
  { href: `${base}#vision`, label: "이미지" },
  { href: `${base}#language`, label: "언어" },
  { href: `${base}#generative`, label: "생성 모델" },
  { href: `${base}#context`, label: "큰 그림" },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    {description && <meta name="description" content={description} />}
    <title>{fullTitle}</title>
  </head>
  <body>
    {!hideNav && (
      <header class="site-header">
        <a href={base} class="site-logo">{siteName}</a>
        <nav aria-label="주제">
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        </nav>
      </header>
    )}
    <slot />
  </body>
</html>

<style>
  .site-header {
    max-width: 1440px;
    margin: 0 auto;
    padding: 18px 72px;
    display: flex;
    align-items: center;
    gap: 56px;
    font-size: 15px;
    line-height: 24px;
  }
  .site-logo {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    text-decoration: none;
  }
  .site-header nav { display: flex; gap: 32px; }
  .site-header nav a { color: var(--text-primary); text-decoration: none; font-weight: 500; }
  .site-header nav a:hover { color: var(--text-secondary); }
  @media (max-width: 900px) {
    .site-header { padding: 16px 20px; }
    .site-header nav { display: none; }
  }
</style>
