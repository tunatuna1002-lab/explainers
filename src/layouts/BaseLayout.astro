---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  hideNav?: boolean;
}
const { title, description, hideNav = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const siteName = "explainers";
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    {description && <meta name="description" content={description} />}
    <title>{fullTitle}</title>
  </head>
  <body>
    {!hideNav && (
      <div class="mx-auto flex max-w-[1280px] items-center justify-between px-6 pt-5 text-[14px] leading-5">
        <a href={base} class="font-semibold text-ink no-underline hover:underline">{siteName}</a>
      </div>
    )}
    <slot />
  </body>
</html>
